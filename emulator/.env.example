# Copy to emulator/.env, set OTA_DIR, then run ./emulator/run.sh up && ./emulator/run.sh boot.
# Compose reads this file; run.sh up updates OTA_DIR and preserves other entries.
# Shell environment variables override values in this file for Compose commands.

# Empty uses the reviewed default from firmware/active-version.
# Set an explicit version to pin this installation to a reviewed profile.
# OTA_DIR must point to the selected version's main_os/ota_vNNN chunk directory,
# not the ZIP or its outer folder. See firmware/README.md.
FW_VERSION=
OTA_DIR=/absolute/path/to/SNOWSKY_DISC_update_.../main_os/ota_v257

# Host media directory. Setup rebuilds the emulated FAT image from these files.
SD_DIR=./emulator/sdcard

# Persistent Docker volume: extracted firmware, settings, library and capture.
# Set WORK_VOLUME explicitly to reuse an existing volume. For a DIFFERENT firmware use
# a NEW volume, e.g. snowsky-disc-work-v257; changing FW_VERSION does not migrate rootfs.
# To keep an existing V2.40 volume, set FW_VERSION=2.40 and its matching OTA_DIR.
WORK_VOLUME=snowsky-disc-work

# Setup language (stock index): 0 zh, 1 tw, 2 en, 3 ja, 4 ko, 5 es,
# 6 it, 7 de, 8 pt, 9 ru. Setup writes it to a new settings database (or one with no
# language chosen yet), which skips the language wizard; later setups keep the player's choice.
LANG_CODE=2

# Maximum guest lifetime in seconds (0 = no limit). Boot sets the guest deadline;
# changing this requires recreating the container and restarting the guest.
GUEST_TTL=1800

# Boot mode: direct (the emulator starts mq_ui and mq_player) or init (stock rcS,
# S98FIIO and fiio_init.sh with its watch loop). See emulator/docs/stock-init.md.
BOOT_MODE=direct
# Set once, before the first setup of a volume, to make /usr/data a size-limited
# ext4 image like the player's 83 MiB userdata partition. Empty keeps a directory.
USERDATA_MB=
# 1 = setup keeps an existing card image instead of rebuilding it from SD_DIR.
SDCARD_KEEP=0

# Card image (emulator/docs/media-library.md): size in MiB (default content + 32), vfat or
# exfat, and 1 for a real partition table (stock then mounts the card by itself).
SDCARD_MB=
SDCARD_FS=vfat
SDCARD_PARTITION=0
# Network (emulator/docs/network.md): shared (Docker eth1) or isolated (no interface until
# one is added); WLAN0=1 adds an emulated wlan0 (optional WLAN0_STATE, WLAN0_ADDR, WLAN0_MAC).
NETWORK=shared
WLAN0=

# Guest environment presets (emulator/docs/environment.md). Empty keeps the defaults.
# POWER_WATCH=1 serves the stock power-off request without a viewer (direct boot).
POWER_WATCH=0
# USB_POWER=1/0 plugs/unplugs the cable at every setup/boot; empty keeps the stored state.
USB_POWER=
# BATTERY_PROFILE=device gives the player's gauge attributes; values are optional.
BATTERY_PROFILE=
BATTERY_CAPACITY=
BATTERY_VOLTAGE_UV=
BATTERY_TEMP=
# 14 letters/digits for /usr/data/fiio/sn.txt; empty writes nothing.
DEVICE_SN=
# Stock settings preset: emulator (default), factory, always-on; plus COLUMN=INT,... overrides.
SETTINGS_PROFILE=
SETTINGS=

# Analog-output model (emulator/docs/audio.md): 3.5, 4.4 or none; off removes it; empty keeps
# the stored state (initially off: stock sees unmodelled pins).
JACK=
# reject (default), warn or off: a hard-float program that would die on the player's kernel
# is refused by guest_run (emulator/docs/limits.md).
FPU_GUARD=reject
# 1 (default): the image's rebuilt qemu answers framebuffer/input ioctls for STATIC guest
# programs, which load no shim (boot-layer packages); 0 restores the kernel's ENOTTY.
QEMU_DEVICES=1
# Fraction of one CPU for the whole container (0 = no limit): a blunt way to slow the guest.
EMU_CPUS=0

# Viewer capture rate; unchanged frames are suppressed without lossy encoding.
STREAM_FPS=12
# Host names the viewer accepts besides localhost, IP addresses and *.local, comma-separated:
# the name of a reverse proxy in front of it. Other names get 403 (viewer/docs/usage.md).
VIEWER_HOSTS=
# Optional viewer Power-on script, absolute path INSIDE the container.
# Empty uses /repo/emulator/scripts/20_boot.sh. Does not change ./emulator/run.sh boot.
DEVICE_BOOT_SCRIPT=
# Optional WebSocket bridge. Leave disabled for the normal viewer/TCP setup.
# Alternatively: ./emulator/run.sh compose --profile wsbridge up -d wsbridge
# COMPOSE_PROFILES=wsbridge

# Advanced Compose overrides; the launcher addresses the emulator service.
# EMU_IMAGE=snowsky-disc-qemu
# EMU_CONTAINER_NAME=snowsky-disc-qemu

# Apply changed container environment/mounts: ./emulator/run.sh up, then ./emulator/run.sh boot.
# Guest SYSCONFIG settings are separate; see emulator/docs/settings.md.
# Do not put firmware download URLs or GitHub tokens in this file.
